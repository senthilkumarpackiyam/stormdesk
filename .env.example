# Copy to .env and fill in. Never commit .env.

# ElevenLabs API key (restricted: ElevenAgents = Write, Voices = Read, everything else No Access).
ELEVENLABS_API_KEY=

# ngrok authtoken, so ElevenLabs can reach the tools on your laptop.
NGROK_AUTHTOKEN=

# Shared secret the voice agent sends in the X-StormDesk-Key header.
# Leave empty for local development (no check).
STORMDESK_TOOL_SECRET=

# Separate secret for the technician endpoints (/admin, approvals). Leave empty to keep them
# local-only: requests arriving through a tunnel (ngrok) are refused. Never reuse the tool secret.
STORMDESK_ADMIN_SECRET=

# Where the console finds the backend.
# STORMDESK_BACKEND_URL=http://localhost:8000

# Where the practice company's database lives.
# STORMDESK_DB_PATH=data/stormdesk.db

# How many similar reports within the window count as a "ticket storm".
# STORMDESK_STORM_THRESHOLD=3
# STORMDESK_STORM_WINDOW_MIN=30

# Nebius Token Factory (phase 5: the post-call reviewers): tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=

# Optional - LangSmith (shows the reviewers' step-by-step reasoning): smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
